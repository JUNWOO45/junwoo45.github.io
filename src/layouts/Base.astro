---
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const { title = '박준우 블로그', description = '배우고, 만들고, 생각한 것을 기록합니다. 준우의 개인 블로그.' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === '박준우 블로그' ? title : `${title} · 박준우 블로그`}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="박준우 블로그" href="/rss.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={Astro.url.pathname.startsWith('/posts/') ? 'article' : 'website'} />
    <meta property="og:locale" content="ko_KR" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      try { const theme = localStorage.getItem('theme'); if (theme) document.documentElement.dataset.theme = theme; } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">본문으로 건너뛰기</a>
    <div class="shell">
      <header class="site-header">
        <a href="/" class="brand" aria-label="박준우 블로그 홈"><span>박준우 블로그</span></a>
        <nav aria-label="주 메뉴">
          <a href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>글</a>
          <a href="/about/" aria-current={Astro.url.pathname === '/about/' ? 'page' : undefined}>소개</a>
          <button id="theme-toggle" aria-label="화면 테마 변경" title="화면 테마 변경"><span aria-hidden="true">◐</span></button>
        </nav>
      </header>
      <main id="main"><slot /></main>
      <footer><div><a href="/rss.xml">RSS ↗</a><a href="https://github.com/JUNWOO45">GitHub ↗</a></div></footer>
    </div>
    <script>
      document.querySelector('#theme-toggle')?.addEventListener('click', () => {
        const root = document.documentElement;
        const dark = root.dataset.theme ? root.dataset.theme === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = dark ? 'light' : 'dark';
        root.dataset.theme = theme;
        try { localStorage.setItem('theme', theme); } catch {}
      });
    </script>
  </body>
</html>
